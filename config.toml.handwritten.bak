# Helix configuration
# Windows: %APPDATA%\helix\config.toml   (Linux/macOS: ~/.config/helix/config.toml)
#
# Port of nvim/vim/vimrc.global.vim. Helix has no Vimscript, so this is a hand
# translation: only the parts that have a Helix equivalent are here.
#
# Key names: C- = Ctrl, S- = Shift, A- = Alt, "ret" enter, "esc" escape,
# "backspace", "left"/"right"/"up"/"down", "home", "end".
# Values are Helix commands; a list runs them in order.

theme= "ashen"

[editor]
default-yank-register = "+"   

[keys.normal]
# --- cursor layout from vimrc.global.vim -------------------------------------
# vimrc: i=k(up)  j=h(left)  k=j(down)  h=a(append)  a=i(insert)  l unchanged
i = "move_visual_line_up"
j = "move_char_left"
k = "move_visual_line_down"
# l = "move_char_right"      # already the default
a = "insert_mode"            # press `a` to type (stock Helix uses `i`)
h = "append_mode"            # press `h` to append


#Move line up
"A-up" = ["extend_to_line_bounds", "delete_selection", "move_line_up", "paste_before"]
# Move line down
"A-down" = ["extend_to_line_bounds", "delete_selection", "paste_after"]


# --- line open / delete (vimrc: <Enter> = o<Esc>, x = "_x, <BS> = "_h<Delete>)
ret = ["open_below", "normal_mode"]
x = "delete_selection_noyank"
backspace = ["move_char_left", "delete_selection_noyank"]

# --- $ and ^ swapped (vimrc: noremap $ ^ / noremap ^ $)
#"$" = "goto_line_start"
#"^" = "goto_line_end"

# --- scrolling / word jumps (vimrc C-i C-k = scroll, C-j = 2B, C-l = 2W) ------
# "M$" in the vimrc = middle of screen then end of line -> half page + line end.
# "C-i" = ["page_cursor_half_up", "goto_line_end"]
# "C-k" = ["page_cursor_half_down", "goto_line_end"]
# "C-up" = ["page_cursor_half_up", "goto_line_end"]
# "C-down" = ["page_cursor_half_down", "goto_line_end"]
# "S-up" = ["page_cursor_half_up", "goto_line_end"]
# "S-down" = ["page_cursor_half_down", "goto_line_end"]
# "C-j" = ["move_prev_long_word_start", "move_prev_long_word_start"]
# "C-l" = ["move_next_long_word_start", "move_next_long_word_start"]

# --- extend by word / to line edge (vimrc S-Left vB, S-Right vW, S-Home v^, S-End V$)
"S-left" = ["select_mode", "move_prev_long_word_start"]
"S-right" = ["select_mode", "move_next_long_word_start"]
"S-home" = ["select_mode", "goto_line_start"]
"S-end" = ["select_mode", "goto_line_end"]

[keys.select]
# `>` / `<` already keep the selection in Helix, so the vimrc's gv> trick is gone.
"$" = "goto_line_start"
"^" = "goto_line_end"
"C-j" = ["move_prev_long_word_start", "move_prev_long_word_start"]
"C-l" = ["move_next_long_word_start", "move_next_long_word_start"]
"C-up" = ["page_cursor_half_up", "goto_line_end"]
"C-down" = ["page_cursor_half_down", "goto_line_end"]
"S-up" = ["page_cursor_half_up", "goto_line_end"]
"S-down" = ["page_cursor_half_down", "goto_line_end"]
"S-home" = ["goto_line_start"]
"S-end" = ["goto_line_end"]
p = "replace_with_yanked"    # vimrc: vnoremap p "_dP

[keys.insert]
# vimrc: <S-Up>/<C-Up> = leave insert, page up, jump to end of line
"S-up" = ["normal_mode", "page_cursor_half_up", "goto_line_end"]
"C-up" = ["normal_mode", "page_cursor_half_up", "goto_line_end"]
"S-down" = ["normal_mode", "page_cursor_half_down", "goto_line_end"]
"C-down" = ["normal_mode", "page_cursor_half_down", "goto_line_end"]

